NullIndex <- function(y, Value){
if(Value$type=="==A"){
index <- which(y==Value$v)
}else if(Value$type=="<=A"){
index <- which(y<=Value$v)
}else if(Value$type==">=B"){
index <- which(y>=Value$v)
}else if(Value$type=="<=A|>=B"){
index <- which(y<=Value$v[1]|y>=Value$v[2])
}else if(Value$type==">=A&<=B"){
index <- which(y>=Value$v[1]&y<=Value$v[2])
}
return(index)
}
